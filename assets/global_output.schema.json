{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "global_output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "miti-chat-pilot-0.4"
    },
    "transcript_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "needs_review"
      ]
    },
    "ratings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cultivating_change_talk": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "rationale": {
              "type": "string"
            },
            "manual_reference": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "message_id": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  },
                  "occurrence_index": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "message_id",
                  "quote",
                  "occurrence_index"
                ]
              },
              "minItems": 0
            }
          },
          "required": [
            "score",
            "rationale",
            "manual_reference",
            "evidence"
          ]
        },
        "softening_sustain_talk": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "rationale": {
              "type": "string"
            },
            "manual_reference": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "message_id": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  },
                  "occurrence_index": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "message_id",
                  "quote",
                  "occurrence_index"
                ]
              },
              "minItems": 0
            }
          },
          "required": [
            "score",
            "rationale",
            "manual_reference",
            "evidence"
          ]
        },
        "partnership": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "rationale": {
              "type": "string"
            },
            "manual_reference": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "message_id": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  },
                  "occurrence_index": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "message_id",
                  "quote",
                  "occurrence_index"
                ]
              },
              "minItems": 0
            }
          },
          "required": [
            "score",
            "rationale",
            "manual_reference",
            "evidence"
          ]
        },
        "empathy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "rationale": {
              "type": "string"
            },
            "manual_reference": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "message_id": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  },
                  "occurrence_index": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "message_id",
                  "quote",
                  "occurrence_index"
                ]
              },
              "minItems": 0
            }
          },
          "required": [
            "score",
            "rationale",
            "manual_reference",
            "evidence"
          ]
        }
      },
      "required": [
        "cultivating_change_talk",
        "softening_sustain_talk",
        "partnership",
        "empathy"
      ]
    },
    "review_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    }
  },
  "required": [
    "protocol_version",
    "transcript_id",
    "status",
    "ratings",
    "review_notes"
  ]
}
